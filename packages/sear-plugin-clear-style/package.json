{
  "name": "@searsuite/sear-plugin-clear-style",
  "description": "Clears Sheet formatting through contributions from its state owners.",
  "version": "0.0.1",
  "license": "MIT",
  "homepage": "https://searsuite.com/",
  "keywords": [
    "searsuite",
    "spreadsheet",
    "clear-formatting",
    "plugin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@searsuite/sear-assembly-commands": "workspace:*",
    "@searsuite/sear-assembly-plugin": "workspace:*",
    "@searsuite/sear-foundation-di": "workspace:*",
    "@searsuite/sear-foundation-error": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SearSuite/searsuite.git",
    "directory": "packages/sear-plugin-clear-style"
  },
  "bugs": {
    "url": "https://github.com/SearSuite/searsuite/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
