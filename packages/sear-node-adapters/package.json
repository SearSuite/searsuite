{
  "name": "@searsuite/sear-node-adapters",
  "version": "0.0.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SearSuite/searsuite.git",
    "directory": "packages/sear-node-adapters"
  },
  "homepage": "https://searsuite.com/",
  "keywords": [
    "searsuite",
    "nodejs",
    "platform-adapters"
  ],
  "description": "Node platform and web-service adapters for SearSuite.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@searsuite/sear-foundation-di": "workspace:*",
    "@searsuite/sear-foundation-platform": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
