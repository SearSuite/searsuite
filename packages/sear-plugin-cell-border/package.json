{
  "name": "@searsuite/sear-plugin-cell-border",
  "description": "Adds Sheet cell borders, commands, rendering, history, and collaboration.",
  "version": "0.0.1",
  "license": "MIT",
  "homepage": "https://searsuite.com/",
  "keywords": [
    "searsuite",
    "spreadsheet",
    "cell-borders",
    "plugin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@searsuite/sear-assembly-commands": "workspace:*",
    "@searsuite/sear-assembly-plugin": "workspace:*",
    "@searsuite/sear-domain-matrix": "workspace:*",
    "@searsuite/sear-domain-ot": "workspace:*",
    "@searsuite/sear-domain-transaction": "workspace:*",
    "@searsuite/sear-foundation-di": "workspace:*",
    "@searsuite/sear-foundation-error": "workspace:*",
    "@searsuite/sear-render-engine": "workspace:*",
    "@searsuite/sear-render-node": "workspace:*",
    "@searsuite/sear-render-registry": "workspace:*",
    "@searsuite/sear-assembly-core": "workspace:*",
    "@searsuite/sear-assembly-config": "workspace:*",
    "@searsuite/sear-render": "workspace:*",
    "@searsuite/sear-render-context": "workspace:*",
    "@searsuite/sear-plugin-cell-merge": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SearSuite/searsuite.git",
    "directory": "packages/sear-plugin-cell-border"
  },
  "bugs": {
    "url": "https://github.com/SearSuite/searsuite/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
