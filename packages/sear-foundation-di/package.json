{
  "name": "@searsuite/sear-foundation-di",
  "description": "Provides editor-scoped dependency injection with explicit ownership and borrowed instances.",
  "version": "0.0.2",
  "license": "MIT",
  "homepage": "https://searsuite.com/",
  "keywords": [
    "searsuite",
    "editor",
    "dependency-injection",
    "service-container"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "test": "jest --coverage"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "@searsuite/sear-foundation-error": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SearSuite/searsuite.git",
    "directory": "packages/sear-foundation-di"
  },
  "bugs": {
    "url": "https://github.com/SearSuite/searsuite/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
