{
  "name": "@searsuite/sear-assembly-sheet-state",
  "description": "Composes Sheet document snapshots and codecs without presentation services.",
  "version": "0.0.3",
  "license": "MIT",
  "homepage": "https://searsuite.com/",
  "keywords": [
    "searsuite",
    "editor",
    "plugins",
    "extensions"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@searsuite/sear-assembly-plugin": "workspace:*",
    "@searsuite/sear-domain-matrix": "workspace:*",
    "@searsuite/sear-domain-sheet": "workspace:*",
    "@searsuite/sear-foundation-error": "workspace:*",
    "@searsuite/sear-plugin-alignment": "workspace:*",
    "@searsuite/sear-plugin-cell-border": "workspace:*",
    "@searsuite/sear-plugin-cell-fill": "workspace:*",
    "@searsuite/sear-plugin-cell-format": "workspace:*",
    "@searsuite/sear-plugin-cell-highlight": "workspace:*",
    "@searsuite/sear-plugin-cell-merge": "workspace:*",
    "@searsuite/sear-plugin-data-validation": "workspace:*",
    "@searsuite/sear-plugin-duplicate": "workspace:*",
    "@searsuite/sear-plugin-export": "workspace:*",
    "@searsuite/sear-plugin-filter": "workspace:*",
    "@searsuite/sear-plugin-fixed-row": "workspace:*",
    "@searsuite/sear-plugin-freeze": "workspace:*",
    "@searsuite/sear-plugin-resize": "workspace:*",
    "@searsuite/sear-plugin-sheet-data": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SearSuite/searsuite.git",
    "directory": "packages/sear-assembly-sheet-state"
  },
  "bugs": {
    "url": "https://github.com/SearSuite/searsuite/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
