{
  "name": "@searsuite/sear-plugin-formula-engineering",
  "description": "Provides Excel-compatible engineering formulas independent of a host.",
  "version": "0.0.3",
  "license": "MIT",
  "homepage": "https://searsuite.com/",
  "keywords": [
    "searsuite",
    "spreadsheet",
    "engineering-formulas",
    "plugin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@searsuite/sear-domain-formula-engine": "workspace:*",
    "@searsuite/sear-domain-formula-engine-ts": "workspace:*",
    "@searsuite/sear-foundation-error": "workspace:*",
    "@searsuite/sear-foundation-utils": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SearSuite/searsuite.git",
    "directory": "packages/sear-plugin-formula-engineering"
  },
  "bugs": {
    "url": "https://github.com/SearSuite/searsuite/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
