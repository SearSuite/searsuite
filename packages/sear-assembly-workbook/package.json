{
  "name": "@searsuite/sear-assembly-workbook",
  "version": "0.0.2",
  "license": "MIT",
  "homepage": "https://searsuite.com/",
  "keywords": [
    "searsuite",
    "spreadsheet",
    "workbook",
    "editor"
  ],
  "description": "Workbook structure, sheet mounting, workbook commands, and shared runtime services.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@searsuite/sear-assembly-commands": "workspace:*",
    "@searsuite/sear-assembly-setup": "workspace:*",
    "@searsuite/sear-assembly-workbook-kernel": "workspace:*",
    "@searsuite/sear-domain-workbook": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SearSuite/searsuite.git",
    "directory": "packages/sear-assembly-workbook"
  },
  "bugs": {
    "url": "https://github.com/SearSuite/searsuite/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
