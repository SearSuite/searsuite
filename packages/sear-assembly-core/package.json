{
  "name": "@searsuite/sear-assembly-core",
  "description": "Stages and commits transactions in the Sheet and Doc runtimes.",
  "version": "0.0.1",
  "license": "MIT",
  "homepage": "https://searsuite.com/",
  "keywords": [
    "searsuite",
    "spreadsheet",
    "editor",
    "transactions"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@searsuite/sear-assembly-config": "workspace:*",
    "@searsuite/sear-assembly-doc": "workspace:*",
    "@searsuite/sear-assembly-plugin": "workspace:*",
    "@searsuite/sear-assembly-sheet-kernel": "workspace:*",
    "@searsuite/sear-assembly-sheet-state": "workspace:*",
    "@searsuite/sear-domain-doc": "workspace:*",
    "@searsuite/sear-domain-doc-schema": "workspace:*",
    "@searsuite/sear-domain-editor": "workspace:*",
    "@searsuite/sear-domain-matrix": "workspace:*",
    "@searsuite/sear-domain-ot": "workspace:*",
    "@searsuite/sear-domain-sheet": "workspace:*",
    "@searsuite/sear-domain-transaction": "workspace:*",
    "@searsuite/sear-foundation-di": "workspace:*",
    "@searsuite/sear-foundation-error": "workspace:*",
    "@searsuite/sear-foundation-platform": "workspace:*",
    "@searsuite/sear-foundation-rect": "workspace:*",
    "@searsuite/sear-foundation-subscription": "workspace:*",
    "@searsuite/sear-foundation-utils": "workspace:*",
    "@searsuite/sear-render-context": "workspace:*",
    "@searsuite/sear-render-engine": "workspace:*",
    "@searsuite/sear-render-event-engine": "workspace:*",
    "@searsuite/sear-render-metrics": "workspace:*",
    "@searsuite/sear-render-node": "workspace:*",
    "@searsuite/sear-render-registry": "workspace:*",
    "@searsuite/sear-render-scroll": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SearSuite/searsuite.git",
    "directory": "packages/sear-assembly-core"
  },
  "bugs": {
    "url": "https://github.com/SearSuite/searsuite/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
