{
  "name": "@searsuite/sear-plugin-resize",
  "description": "Adds Sheet row and column sizing, resize interaction, rendering, and persistence.",
  "version": "0.0.1",
  "license": "MIT",
  "homepage": "https://searsuite.com/",
  "keywords": [
    "searsuite",
    "spreadsheet",
    "row-column-resize",
    "plugin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@searsuite/sear-assembly-commands": "workspace:*",
