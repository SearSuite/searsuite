{
  "name": "searsuite",
  "description": "TypeScript workspace for SearSuite's platform-neutral spreadsheet and document editor packages.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "generate:formula-help": "node scripts/generate-formula-help.mjs",
    "check:formula-help": "node scripts/generate-formula-help.mjs --check",
    "check:source-docs": "node scripts/check-source-comments.mjs",
    "clean": "pnpm run -r clean",
    "build": "pnpm run -r build",
    "test": "pnpm run test:full",
    "test:quick": "jest --runInBand --changedSince=${TEST_BASE_REF:-HEAD~1} --passWithNoTests",
    "test:unit": "jest --runInBand",
    "test:input-editing": "jest --runInBand --silent packages/sear-assembly-setup/spec/SheetSelectionKeyboard.spec.ts packages/sear-plugin-sheet-doc-adapter/spec/SearCoreEditorAdapter.spec.ts packages/sear-plugin-cell-editor/spec/SheetCellEditorRender.spec.ts packages/sear-domain-cell/spec/CellClipboardCodecRegistry.spec.ts packages/sear-plugin-formula/spec/CellFormulaValueConverterRegistry.spec.ts packages/sear-domain-commands/spec/DocCommand.spec.ts",
    "test:coverage": "jest --runInBand --coverage && pnpm run check:coverage",
    "test:full": "pnpm run test:coverage",
    "check:architecture": "node ./scripts/check-architecture.mjs",
    "check:di-boundaries": "node ./scripts/check-di-boundaries.mjs",
    "check:coverage": "node ./scripts/check-coverage.mjs",
    "check:workspace-dependencies": "node ./scripts/check-workspace-dependencies.mjs",
    "check:import-boundaries": "node ./scripts/check-import-boundaries.mjs",
    "check:command-boundaries": "node ./scripts/check-command-boundaries.mjs",
    "check:platform-warnings": "node ./scripts/check-platform-warnings.mjs",
    "check:module-boundaries": "node ./scripts/check-module-boundaries.mjs",
    "check:sheet-doc-boundary": "node ./scripts/check-sheet-doc-boundary.mjs",
    "check:duplication": "jscpd packages --format typescript --min-lines 10 --min-tokens 60 --threshold 2 --silent --ignore '**/spec/**,**/dist/**,**/node_modules/**'",
    "check:external-consumer": "node ./scripts/check-external-consumer.mjs",
    "check:public-api": "node ./scripts/check-public-api.mjs",
    "sync:workspace-dependencies": "node ./scripts/sync-workspace-dependencies.mjs",
    "lint": "pnpm run check:source-docs && pnpm run check:formula-help && pnpm run check:architecture && pnpm run check:di-boundaries && pnpm run check:workspace-dependencies && pnpm run check:import-boundaries && pnpm run check:command-boundaries && pnpm run check:platform-warnings && pnpm run check:plugin-platform && pnpm run check:module-boundaries && pnpm run check:sheet-doc-boundary && pnpm run check:public-api && pnpm run check:duplication && eslint --ext js,ts,tsx .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "verify": "pnpm run verify:full",
    "verify:quick": "pnpm run check:architecture && pnpm run check:di-boundaries && pnpm run check:workspace-dependencies && pnpm run check:import-boundaries && pnpm run check:command-boundaries && pnpm run check:public-api && pnpm run check:plugin-platform && pnpm run test:quick",
    "verify:full": "pnpm run lint && pnpm run test:full && pnpm run build && pnpm run check:external-consumer",
    "release:check": "pnpm run verify:full && pnpm run check:public-api",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release:stage": "pnpm run check:public-api && pnpm run build && node scripts/stage-npm-release.mjs",
    "release:stage:resume": "node scripts/stage-npm-release.mjs",
    "release:stage:plan": "node scripts/stage-npm-release.mjs --dry-run",
    "setup:git-hooks": "git config core.hooksPath .githooks",
    "check:plugin-platform": "node ./scripts/check-plugin-platform-boundaries.mjs"
  },
  "size-limit": [],
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 120
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@nighttrax/eslint-config-tsx": "12.0.0-alpha.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "eslint": "~9.39.1",
    "eslint-plugin-import": "~2.32.0",
    "jest": "^30.4.2",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.4.1",
    "jscpd": "4.0.5",
    "rimraf": "~6.1.3",
    "ts-jest": "^29.4.14",
    "typescript": "~5.8.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "handlebars": "4.7.10",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "markdown-it": "14.3.2",
      "minimatch@3": "3.1.5",
      "nanoid@3": "3.3.20",
      "postcss": "8.5.29",
      "probe-image-size": "7.4.0",
      "serialize-javascript": "7.0.5",
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SearSuite/searsuite.git"
  },
  "bugs": {
    "url": "https://github.com/SearSuite/searsuite/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
